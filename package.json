{
  "name": "@verify-repo/root",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agorischek/verify-repo.git"
  },
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/plugins/*",
    "packages/cli",
    "packages/bundle"
  ],
  "scripts": {
    "build": "cd packages/bundle && bun run build",
    "check": "checks",
    "test:package": "bun run build && node scripts/test-package.mjs",
    "verify": "bun packages/bundle/src/bin.ts run",
    "verify:docs": "bun packages/bundle/src/bin.ts docs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:format": "prettier --check ."
  },
  "checks": {
    "runner": "bun",
    "scripts": [
      "typecheck",
      "build",
      {
        "check": "check:format",
        "fix": "format"
      },
      "test"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "badge-roll": "^0.1.0",
    "bun-types": "latest",
    "check-1-2": "^0.0.7",
    "prettier": "^3.9.6",
    "simple-git": "^3.36.0",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/bun": "^1.3.14"
  }
}
